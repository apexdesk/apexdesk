+/// The registered name of a format named by its MIME type. (ApexDesk patch.)
+fn system_name(mime: &str) -> &str {
+	match mime {
+		"text/html" => "HTML Format",
+		"text/rtf" | "application/rtf" => "Rich Text Format",
+		"image/png" => "PNG",
+		other => other,
+	}
+}
+
+fn mime_of(system: &str) -> String {
+	match system {
+		"HTML Format" => "text/html",
+		"Rich Text Format" => "text/rtf",
+		"PNG" => "image/png",
+		other => other,
+	}
+	.to_string()
+}
+
+fn format_id(mime: &str) -> Option<u32> {
+	if mime == "text/plain" {
+		return Some(clipboard_win::formats::CF_UNICODETEXT);
+	}
+	clipboard_win::register_format(system_name(mime)).map(|f| f.get())
+}
