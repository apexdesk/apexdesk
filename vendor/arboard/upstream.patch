+	/// The atom of a format named by its MIME type; text is `UTF8_STRING`.
+	fn format_atom(&self, name: &str) -> Result<Atom> {
+		if name == "text/plain" {
+			return Ok(self.inner.atoms.UTF8_STRING);
+		}
+		let conn = &self.inner.server.conn;
+		Ok(conn.intern_atom(false, name.as_bytes()).map_err(into_unknown)?.reply().map_err(into_unknown)?.atom)
+	}
+
+	pub(crate) fn get_format(
+		&self,
+		names: &[&str],
+		selection: LinuxClipboardKind,
+	) -> Result<(String, Vec<u8>)> {
+		// Text is asked for under each of its names.
+		let mut atoms = Vec::new();
+		for &name in names {
+			if name == "text/plain" {
+				for a in [
+					self.inner.atoms.UTF8_STRING,
+					self.inner.atoms.UTF8_MIME_0,
+					self.inner.atoms.UTF8_MIME_1,
+					self.inner.atoms.TEXT_MIME_UNKNOWN,
+				] {
+					atoms.push((name, a));
+				}
+			} else {
+				atoms.push((name, self.format_atom(name)?));
+			}
+		}
+		// Only the formats the owner offers: asking for others makes some wait for nothing.
+		let offered = self.get_format_atoms(selection).unwrap_or_default();
+		atoms.retain(|(_, a)| offered.is_empty() || offered.contains(a));
+		let list: Vec<Atom> = atoms.iter().map(|(_, a)| *a).collect();
+		let result = self.inner.read(&list, selection)?;
+		let name = atoms.iter().find(|(_, a)| *a == result.format).map_or("", |(n, _)| *n);
+		Ok((name.to_string(), result.bytes))
+	}
+
+	fn get_format_atoms(&self, selection: LinuxClipboardKind) -> Result<Vec<Atom>> {
+		if self.inner.is_owner(selection)? {
+			let data = self.inner.selection_of(selection).data.read();
+			return Ok(data.iter().flatten().map(|d| d.format).collect());
+		}
+		let reader = XContext::new()?;
+		let bytes = self.inner.read_single(&reader, selection, self.inner.atoms.TARGETS)?;
+		Ok(bytes.chunks_exact(4).map(|c| u32::from_ne_bytes([c[0], c[1], c[2], c[3]])).collect())
+	}
+
+	pub(crate) fn get_formats(&self, selection: LinuxClipboardKind) -> Result<Vec<String>> {
+		let atoms = self.get_format_atoms(selection)?;
+		let a = &self.inner.atoms;
+		let mut names = Vec::new();
+		for atom in atoms {
+			let name = if [a.UTF8_STRING, a.UTF8_MIME_0, a.UTF8_MIME_1, a.TEXT_MIME_UNKNOWN, a.STRING, a.TEXT]
+				.contains(&atom)
+			{
+				"text/plain".to_string()
+			} else {
+				self.inner.atom_name(atom)?
+			};
+			if !names.contains(&name) {
+				names.push(name);
+			}
+		}
+		Ok(names)
+	}
+
+	pub(crate) fn set_formats(
+		&self,
+		formats: &[(&str, &[u8])],
+		selection: LinuxClipboardKind,
+		wait: WaitConfig,
+		exclude_from_history: bool,
+	) -> Result<()> {
+		let mut data = Vec::with_capacity(formats.len() + 1);
+		for (name, bytes) in formats {
+			data.push(ClipboardData { bytes: bytes.to_vec(), format: self.format_atom(name)? });
+		}
+		self.add_clipboard_exclusions(exclude_from_history, &mut data);
+		self.inner.write(data, selection, wait)
+	}
