+	pub(crate) fn format(self, names: &[&str]) -> Result<(String, Vec<u8>), Error> {
+		let _clipboard_assertion = self.clipboard?;
+		for &name in names {
+			let Some(id) = format_id(name) else { continue };
+			if !clipboard_win::is_format_avail(id) {
+				continue;
+			}
+			let mut out = Vec::new();
+			// "HTML Format" is read whole, header and context included:
+			// `get_html` fails on a memory block whose bytes past the
+			// zero aren't UTF-8, and leaves out the tags around the
+			// fragment (the lists and tables it is in). (ApexDesk patch.)
+			let read = match name {
+				"text/plain" => clipboard_win::raw::get_string(&mut out),
+				_ => clipboard_win::raw::get_vec(id, &mut out),
+			};
+			if read.is_err() {
+				continue;
+			}
+			// Text formats end where the zero is; the memory block may be longer.
+			if name.starts_with("text/") || name == "application/rtf" {
+				if let Some(end) = out.iter().position(|&b| b == 0) {
+					out.truncate(end);
+				}
+			}
+			return Ok((name.to_string(), out));
+		}
+		Err(Error::ContentNotAvailable)
+	}
