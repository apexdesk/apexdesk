# Maintainer: ApexDesk <50219414+apexdesk@users.noreply.github.com>
pkgname=apexdesk-bin
pkgver=0.8.0
pkgrel=1
pkgdesc="Free office suite: documents, spreadsheets, presentations, PDF, databases and notebooks"
arch=('x86_64')
url="https://apexdesk.github.io/"
license=('LicenseRef-ApexDesk')
depends=('glibc' 'gcc-libs' 'alsa-lib' 'dbus' 'libx11' 'libxcursor' 'libxi' 'libxrender'
         'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'libglvnd' 'curl' 'hicolor-icon-theme')
optdepends=('gst-plugins-base: video and sound in presentations'
            'gst-plugins-good: video and sound in presentations'
            'hunspell-en_us: spelling (or any other hunspell dictionary)'
            'xdg-utils: opening links and files with other programs')
provides=('apexdesk')
conflicts=('apexdesk')
options=('!strip' '!debug')
source=("https://github.com/apexdesk/apexdesk/releases/download/v${pkgver}/apexdesk-${pkgver}-linux-x86_64-portable.tar.gz"
        'apexdesk.desktop'
        'apexdesk-mime.xml'
        'apexdesk.svg')
sha256sums=('5ffc9da1cbe7b7b78fc18833af76e00656369a959277ac98d1b136727342a407'
            'ee00aedeff5e26bde6f0bf7d18ad28f7e001e493ba1a05804a816526b461dcdf'
            '0f5f53b985ccced98108aeeb978f29779f7141bda5a4de58e12b46a9b85d5d11'
            '68d0cbf0878537b3dc66c5c7e515182554e01b593bfd0ad0c2fbae74df84ad9e')

package() {
    cd "apexdesk-${pkgver}-linux-x86_64-portable"
    # The "portable" marker is left out: settings go to ~/.config/apexdesk.
    install -Dm755 apexdesk "$pkgdir/usr/lib/apexdesk/apexdesk"
    install -d "$pkgdir/usr/bin"
    ln -s ../lib/apexdesk/apexdesk "$pkgdir/usr/bin/apexdesk"
    install -Dm644 "$srcdir/apexdesk.desktop" "$pkgdir/usr/share/applications/apexdesk.desktop"
    install -Dm644 "$srcdir/apexdesk-mime.xml" "$pkgdir/usr/share/mime/packages/apexdesk.xml"
    install -Dm644 "$srcdir/apexdesk.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/apexdesk.svg"
    install -Dm644 apexdesk.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/apexdesk.png"
    for f in LICENSE EULA.md EULA.es.md; do
        install -Dm644 "$f" "$pkgdir/usr/share/licenses/$pkgname/$f"
    done
    install -Dm644 THIRD-PARTY-NOTICES.md "$pkgdir/usr/share/doc/apexdesk/THIRD-PARTY-NOTICES.md"
}
