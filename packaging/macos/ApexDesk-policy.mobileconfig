<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- A sample configuration profile with every ApexDesk policy: remove
     the ones not wanted, change the values and the identifiers, then
     deploy it with your MDM (made by the apexdesk policy command). -->
<plist version="1.0">
<dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadType</key>
			<string>com.github.apexdesk.apexdesk</string>
			<key>PayloadIdentifier</key>
			<string>com.example.apexdesk.policy.settings</string>
			<key>PayloadUUID</key>
			<string>6B0E2C56-3F43-4B0B-9D0A-6B6C9E1C2A01</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>MacroSecurity</key>
			<string>signed</string>
			<key>TrustedLocations</key>
			<array>
				<string>/Volumes/Company/Macros</string>
				<string>/Users/Shared/Macros</string>
			</array>
			<key>TemplatesFolder</key>
			<string>/Volumes/Company/Templates</string>
			<key>BuildingBlocksFolder</key>
			<string>/Volumes/Company/Building Blocks</string>
			<key>LibraryFolder</key>
			<string>/Volumes/Company/Library</string>
			<key>SeatsFolder</key>
			<string>/Volumes/Company/ApexDesk Seats</string>
			<key>OnlySharedTemplates</key>
			<true/>
			<key>DefaultSheetFormat</key>
			<string>xlsx</string>
			<key>DefaultDocFormat</key>
			<string>docx</string>
			<key>UILanguage</key>
			<string>es</string>
			<key>SpellingLanguage</key>
			<string>es_ES</string>
			<key>DictionariesFolder</key>
			<string>/Volumes/Company/Dictionaries</string>
			<key>DisableGetData</key>
			<false/>
			<key>Proxy</key>
			<string>http://proxy.example.com:3128</string>
			<key>ProxyBypass</key>
			<string>.corp.example.com, intranet</string>
			<key>SignInSites</key>
			<string>.corp.example.com</string>
			<key>SupportEmail</key>
			<string>helpdesk@example.com</string>
			<key>FontSubstitutes</key>
			<string>Corporate Sans=Liberation Sans; Corporate Serif=Liberation Serif</string>
			<key>CertificateRoots</key>
			<string>/Volumes/Company/Certificates</string>
			<key>SignatureLevel</key>
			<string>lt</string>
			<key>TimestampURL</key>
			<string>http://timestamp.example.com</string>
			<key>Renderer</key>
			<string>glow</string>
			<key>LockFiles</key>
			<true/>
			<key>LinkSecurity</key>
			<string>ask</string>
			<key>ProtectedView</key>
			<true/>
			<key>AllowAIAssistants</key>
			<false/>
			<key>AllowAutomationAPI</key>
			<false/>
			<key>AutosaveMinutes</key>
			<integer>5</integer>
			<key>RequiredProperties</key>
			<array>
				<string>Client</string>
				<string>Case number</string>
			</array>
			<key>CheckBeforeSharing</key>
			<string>warn</string>
			<key>BrandFonts</key>
			<array>
				<string>Inter</string>
				<string>Source Serif 4</string>
			</array>
			<key>BrandColors</key>
			<array>
				<string>#1F4E79</string>
				<string>#C00000</string>
				<string>#F2A900</string>
			</array>
			<key>ForbiddenTerms</key>
			<array>
				<string>Confidential draft</string>
				<string>ACME Corp</string>
			</array>
		</dict>
	</array>
	<key>PayloadDisplayName</key>
	<string>ApexDesk</string>
	<key>PayloadIdentifier</key>
	<string>com.example.apexdesk.policy</string>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>6B0E2C56-3F43-4B0B-9D0A-6B6C9E1C2A00</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
</dict>
</plist>
