<?xml version="1.0" encoding="utf-8"?>
<!-- Made by the apexdesk policy command: edit the program, not this file. -->
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>ApexDesk</displayName>
  <description>조직 정책</description>
  <resources>
    <stringTable>
      <string id="ApexDesk">ApexDesk</string>
      <string id="SUPPORTED_ApexDesk">ApexDesk 0.1 이상</string>
      <string id="MacroSecurity">매크로 보안</string>
      <string id="MacroSecurity_Help">VBA 매크로 실행 여부: 실행 안 함, 사용자에게 먼저 묻기, 신뢰할 수 있는 인증서로 서명된 프로젝트만 실행.</string>
      <string id="MacroSecurity_disabled">모든 매크로 사용 안 함</string>
      <string id="MacroSecurity_ask">매크로를 사용하기 전에 확인</string>
      <string id="MacroSecurity_signed">신뢰할 수 있는 인증서로 서명된 매크로만</string>
      <string id="TrustedLocations">신뢰할 수 있는 위치</string>
      <string id="TrustedLocations_Help">열 때 매크로가 사용되는 파일의 폴더입니다. 사용자가 추가한 폴더를 대체합니다.</string>
      <string id="TrustedPublishers">신뢰할 수 있는 매크로 게시자</string>
      <string id="TrustedPublishers_Help">&quot;서명된 매크로만&quot;에서 서명된 매크로가 실행되는 인증서 (SHA-256 또는 SHA-1 지문, 16진수). 설정하면 이들이 서명한 매크로만 실행되며 사용자가 추가할 수 없습니다.</string>
      <string id="DisableMacroEditor">매크로 편집기 끄기</string>
      <string id="DisableMacroEditor_Help">1: 매크로 편집기(Alt+F11)를 열 수 없습니다. 매크로는 매크로 보안 정책에 따라 계속 실행됩니다.</string>
      <string id="TemplatesFolder">공유 서식 파일 폴더</string>
      <string id="TemplatesFolder_Help">[서식 파일에서 새로 만들기]에 사용자 서식 파일과 함께 표시되는 서식 파일(docx, dotx, odt, xlsx, xltx, ods 등) 폴더입니다.</string>
      <string id="BuildingBlocksFolder">공유 문서 블록 폴더</string>
      <string id="BuildingBlocksFolder_Help">용어집(.docx, .dotx, .dotm. Normal.dotm, Building Blocks.dotx 등) 폴더로, 그 문서 블록을 사용자의 것과 함께 제공합니다(읽기 전용).</string>
      <string id="LibraryFolder">공유 그림 라이브러리 폴더</string>
      <string id="LibraryFolder_Help">문서, 스프레드시트, 프레젠테이션의 삽입 &gt; 라이브러리에 표시되는 그림(PNG, JPEG, GIF, BMP) 폴더입니다. 하위 폴더는 범주가 됩니다.</string>
      <string id="SeatsFolder">라이선스 좌석 기록 폴더</string>
      <string id="SeatsFolder_Help">기업 라이선스가 있는 각 컴퓨터가 작은 파일(이름, 사용자, 버전, 마지막 사용일)을 남기는 공유 폴더입니다. 정보 &gt; 라이선스에 최근 30일 동안 ApexDesk를 사용한 컴퓨터 수와 계약 좌석 수가 표시됩니다. 아무것도 차단되지 않으며 서버가 필요 없습니다.</string>
      <string id="OnlySharedTemplates">공유 서식 파일만</string>
      <string id="OnlySharedTemplates_Help">서식 파일에서 새로 만들기에 공유 폴더의 서식 파일만 표시하고(기본 제공 및 개인 서식 파일 제외) 서식 파일로 저장을 제공하지 않습니다.</string>
      <string id="DefaultSheetFormat">스프레드시트의 기본 형식</string>
      <string id="DefaultSheetFormat_Help">새 스프레드시트에 대해 다른 이름으로 저장이 먼저 제안하는 형식입니다.</string>
      <string id="DefaultSheetFormat_xlsx">xlsx</string>
      <string id="DefaultSheetFormat_xlsm">xlsm</string>
      <string id="DefaultSheetFormat_ods">ods</string>
      <string id="DefaultSheetFormat_csv">csv</string>
      <string id="DefaultDocFormat">문서의 기본 형식</string>
      <string id="DefaultDocFormat_Help">새 문서에 대해 다른 이름으로 저장이 먼저 제안하는 형식입니다.</string>
      <string id="DefaultDocFormat_docx">docx</string>
      <string id="DefaultDocFormat_docm">docm</string>
      <string id="DefaultDocFormat_odt">odt</string>
      <string id="DefaultDocFormat_rtf">rtf</string>
      <string id="UILanguage">인터페이스 언어</string>
      <string id="UILanguage_Help">메뉴와 대화 상자의 언어: en, es, de, fr, it, pt, ja, ko, zh 또는 zh-Hant.</string>
      <string id="SpellingLanguage">맞춤법 검사 언어</string>
      <string id="SpellingLanguage_Help">맞춤법 검사에 사용하는 사전의 코드(es_ES, en_US 등)입니다.</string>
      <string id="DictionariesFolder">공유 사전 폴더</string>
      <string id="DictionariesFolder_Help">설치된 사전보다 먼저 검색되는 Hunspell 사전(.aff 및 .dic)과 동의어 사전 폴더입니다.</string>
      <string id="DisableGetData">외부 원본에서 데이터 가져오기 끄기</string>
      <string id="DisableGetData_Help">데이터 가져오기 쿼리가 파일, 웹 페이지, 데이터베이스를 읽을 수 없습니다. 통합 문서 자체 표에 대한 쿼리는 계속 작동합니다.</string>
      <string id="Proxy">프록시</string>
      <string id="Proxy_Help">웹 요청(데이터 가져오기, 해지 확인, 타임스탬프)의 프록시입니다. 비워 두면 시스템 설정, &quot;direct&quot;는 사용 안 함, 또는 http://user@proxy:3128 같은 URL.</string>
      <string id="ProxyBypass">프록시 없이 연결할 서버</string>
      <string id="ProxyBypass_Help">직접 연결할 이름 또는 끝부분(.corp.example)을 쉼표로 구분하여 지정합니다. 시스템의 예외에 추가됩니다.</string>
      <string id="SignInSites">Windows 로그인을 사용할 서버</string>
      <string id="SignInSites_Help">웹 요청이 현재 세션으로 로그인할 이름 또는 끝부분을 쉼표로 구분하여 지정합니다(Negotiate를 통한 Kerberos 또는 NTLM).</string>
      <string id="SupportEmail">충돌 보고서를 보낼 주소</string>
      <string id="SupportEmail_Help">사용자가 보고서를 보낼 때 받는 이메일 주소입니다. 보고서는 자동으로 전송되지 않습니다.</string>
      <string id="FontSubstitutes">글꼴 대체</string>
      <string id="FontSubstitutes_Help">설치되어 있지 않을 때 다른 글꼴로 표시할 글꼴입니다. 예: &quot;Corporate Sans=Liberation Sans; Old Serif=Liberation Serif&quot;.</string>
      <string id="CertificateRoots">조직의 루트 인증서</string>
      <string id="CertificateRoots_Help">시스템 인증서 외에 서명에 신뢰할 루트 인증서(.cer, .crt, .der, .pem) 폴더입니다.</string>
      <string id="SignatureLevel">서명 수준</string>
      <string id="SignatureLevel_Help">새 서명의 장기 수준: B, T(타임스탬프), LT(해지 데이터 포함) 또는 LTA(보관).</string>
      <string id="SignatureLevel_b">B</string>
      <string id="SignatureLevel_t">T</string>
      <string id="SignatureLevel_lt">LT</string>
      <string id="SignatureLevel_lta">LTA</string>
      <string id="TimestampURL">타임스탬프 기관</string>
      <string id="TimestampURL_Help">서명에 사용할 타임스탬프 서버(TSA)의 URL입니다.</string>
      <string id="Renderer">그래픽 렌더러</string>
      <string id="Renderer_Help">창을 그리는 방식: 가장 빨리 시작하는 OpenGL 또는 wgpu(Direct3D, Metal, Vulkan). 다음 시작 시 적용됩니다.</string>
      <string id="Renderer_glow">OpenGL</string>
      <string id="Renderer_wgpu">wgpu</string>
      <string id="LockFiles">잠금 파일</string>
      <string id="LockFiles_Help">열린 파일을 잠금 파일로 표시하고(Office, LibreOffice처럼) 다른 사람이 파일을 열고 있으면 경고합니다.</string>
      <string id="LinkSecurity">문서의 링크</string>
      <string id="LinkSecurity_Help">문서에서 파일, 네트워크 폴더, 다른 프로그램에 대한 링크를 처리하는 방법입니다. 웹 및 메일 링크는 항상 열리고, 프로그램, 스크립트, 위험한 링크 유형은 열리지 않습니다.</string>
      <string id="LinkSecurity_ask">열기 전에 묻기</string>
      <string id="LinkSecurity_allow">묻지 않고 열기</string>
      <string id="LinkSecurity_block">열지 않음</string>
      <string id="ProtectedView">다운로드한 파일의 제한된 보기</string>
      <string id="ProtectedView_Help">1: 인터넷에서 다운로드한 것으로 표시된 파일은 사용자가 편집을 사용할 때까지 읽기 전용이며 매크로 없이 열립니다(신뢰할 수 있는 위치의 파일 제외). 0: 다른 파일처럼 열립니다.</string>
      <string id="AllowAIAssistants">AI 도우미 허용(MCP)</string>
      <string id="AllowAIAssistants_Help">&quot;apexdesk mcp&quot;로 연결된 AI 도우미가 ApexDesk에 열린 파일을 읽고 편집할 수 있는지 여부입니다. 0이면 꺼지며 사용자가 켤 수 없습니다.</string>
      <string id="AllowAutomationAPI">자동화 API 허용</string>
      <string id="AllowAutomationAPI_Help">스크립트가 &quot;apexdesk api&quot;로 파일을 변환, 읽기, 쓰기할 수 있는지 여부입니다(비즈니스 라이선스). 0이면 꺼지며 사용자가 켤 수 없고, 1이면 모두에게 켜집니다.</string>
      <string id="AutosaveMinutes">복구 사본 간격(분)</string>
      <string id="AutosaveMinutes_Help">열린 파일의 복구 사본을 저장하는 간격입니다(0이면 끔).</string>
      <string id="RequiredProperties">필수 속성</string>
      <string id="RequiredProperties_Help">통합 문서, 문서 또는 프레젠테이션을 저장하기 전에 있어야 하는 속성(제목 같은 기본 제공 속성 또는 고객 같은 사용자 지정 속성)입니다. 저장할 때 비어 있는 속성을 묻습니다.</string>
      <string id="CheckBeforeSharing">공유 전 검사</string>
      <string id="CheckBeforeSharing_Help">파일을 PDF로 내보내거나 전자 메일로 보내기 전에 개인 정보(전자 메일 주소, 신분증 번호, IBAN, 카드 및 전화번호), 비어 있는 필수 속성, 수식 오류, 메모, 변경 내용 추적을 찾습니다. 경고는 계속할 수 있고, 차단은 무언가 발견되는 동안 계속할 수 없습니다.</string>
      <string id="CheckBeforeSharing_off">끔</string>
      <string id="CheckBeforeSharing_warn">경고</string>
      <string id="CheckBeforeSharing_block">차단</string>
      <string id="BrandFonts">브랜드 글꼴</string>
      <string id="BrandFonts_Help">조직의 글꼴(항목당 하나)입니다. 글꼴 상자 맨 위에 표시되고 공유 전에 검사됩니다. 브랜드를 적용하면 첫 번째 글꼴이 다른 글꼴을 대체합니다.</string>
      <string id="BrandColors">브랜드 색</string>
      <string id="BrandColors_Help">조직의 색을 #RRGGBB로 지정(항목당 하나)합니다. 색 메뉴 맨 위에 표시되고 공유 전에 검사됩니다(검정, 흰색, 회색은 항상 허용).</string>
      <string id="ForbiddenTerms">금지어</string>
      <string id="ForbiddenTerms_Help">문서에 포함되면 안 되는 단어나 구(이전 회사 이름, 내부 코드명 등, 항목당 하나)입니다. 공유 전 검사에서 찾습니다.</string>
    </stringTable>
