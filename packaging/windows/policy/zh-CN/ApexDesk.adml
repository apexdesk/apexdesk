      </presentation>
      <presentation id="SignInSites">
        <textBox refId="SignInSites"><label>使用 Windows 登录的服务器</label></textBox>
      </presentation>
      <presentation id="SupportEmail">
        <textBox refId="SupportEmail"><label>崩溃报告的收件地址</label></textBox>
      </presentation>
      <presentation id="FontSubstitutes">
